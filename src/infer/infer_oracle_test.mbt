///|
test "infer: chi-square goodness of fit, uniform" {
  let r = @infer.chi_square_goodness_of_fit({ counts: [18L, 22L, 30L, 30L], null_probs: None }, fitted_params=0)
  assert_close(r.statistic, 4.32, "statistic")
  assert_close(r.p_value, 0.22891886433610517, "p")
}

///|
test "infer: chi-square goodness of fit, probabilities, one fitted" {
  let r = @infer.chi_square_goodness_of_fit({ counts: [18L, 22L, 30L, 30L], null_probs: Some([0.1, 0.2, 0.3, 0.4]) }, fitted_params=1)
  assert_close(r.statistic, 9.100000000000001, "statistic")
  assert_close(r.p_value, 0.010567204383852648, "p")
}

///|
test "infer: chi-square independence 2x2 correction=True" {
  let t = @data.Table::new(2, 2, [12L, 5L, 7L, 16L][:])
  let r = @infer.chi_square_independence(t, continuity=true)
  assert_close(r.statistic, 4.812286470652336, "statistic")
  assert_close(r.p_value, 0.02825752852636125, "p")
  assert_close(r.df.unwrap(), 1.0, "df")
}

///|
test "infer: chi-square independence 2x2 correction=False" {
  let t = @data.Table::new(2, 2, [12L, 5L, 7L, 16L][:])
  let r = @infer.chi_square_independence(t, continuity=false)
  assert_close(r.statistic, 6.319891801114041, "statistic")
  assert_close(r.p_value, 0.011939091377912247, "p")
  assert_close(r.df.unwrap(), 1.0, "df")
}

///|
test "infer: chi-square independence 2x3 correction=True" {
  let t = @data.Table::new(2, 3, [10L, 20L, 30L, 15L, 15L, 25L][:])
  let r = @infer.chi_square_independence(t, continuity=true)
  assert_close(r.statistic, 1.9551357733175911, "statistic")
  assert_close(r.p_value, 0.3762250088979317, "p")
  assert_close(r.df.unwrap(), 2.0, "df")
}

///|
test "infer: fisher exact [8, 2, 1, 5] (two-sided)" {
  let t = @data.Table::new(2, 2, [8L, 2L, 1L, 5L][:])
  let r = @infer.fisher_exact(t, alternative=TwoSided, two_sided=MinLikelihood)
  assert_close(r.statistic, 20.0, "statistic")
  assert_close(r.p_value, 0.034965034965034975, "p")
}

///|
test "infer: fisher exact [8, 2, 1, 5] (greater)" {
  let t = @data.Table::new(2, 2, [8L, 2L, 1L, 5L][:])
  let r = @infer.fisher_exact(t, alternative=Greater, two_sided=MinLikelihood)
  assert_close(r.statistic, 20.0, "statistic")
  assert_close(r.p_value, 0.024475524475524483, "p")
}

