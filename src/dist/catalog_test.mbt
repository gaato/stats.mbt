    d,
    k=[0, 1, 3, 7],
    pmf=[0.5488116360940264, 0.32928698165641584, 0.01975721889938495, 3.0482566301908205e-06],
    cdf=[0.5488116360940264, 0.8780986177504423, 0.996641931146752, 0.9999997551724977],
    sf=[0.45118836390597356, 0.1219013822495577, 0.003358068853247998, 2.448275022427482e-07],
    p=[1.0e-06, 0.01, 0.25, 0.5, 0.75, 0.99, 0.999999],
    ppf=[0, 0, 0, 0, 1, 3, 7],
  )
}

///|
test "catalog: randint parameters agree with SciPy" {
  ignore(@dist.DiscreteUniform::new(-8, 17))
  ignore(@dist.DiscreteUniform::new(-6, 3))
  ignore(@dist.DiscreteUniform::new(8, 18))
  ignore(@dist.DiscreteUniform::new(-10, -6))
  ignore(@dist.DiscreteUniform::new(-13, 17))
  ignore(@dist.DiscreteUniform::new(-7, 10))
  assert_true(
    (try @dist.DiscreteUniform::new(0, -19) catch { _ => true } noraise { _ => false }),
  )
  assert_true(
    (try @dist.DiscreteUniform::new(3, -19) catch { _ => true } noraise { _ => false }),
  )
  assert_true(
    (try @dist.DiscreteUniform::new(4, -10) catch { _ => true } noraise { _ => false }),
  )
  assert_true(
    (try @dist.DiscreteUniform::new(17, -2) catch { _ => true } noraise { _ => false }),
  )
  assert_true(
    (try @dist.DiscreteUniform::new(3, -15) catch { _ => true } noraise { _ => false }),
  )
  assert_true(
    (try @dist.DiscreteUniform::new(12, 3) catch { _ => true } noraise { _ => false }),
  )
}

///|
test "catalog: randint matches the high-precision oracle" {
  let d = @dist.DiscreteUniform::new(7, 31)
  check_discrete(
    d,
    k=[7, 12, 18, 24, 30],
    pmf=[0.041666666666666664, 0.041666666666666664, 0.041666666666666664, 0.041666666666666664, 0.041666666666666664],
    cdf=[0.041666666666666664, 0.25, 0.5, 0.75, 1.0],
    sf=[0.9583333333333334, 0.75, 0.5, 0.25, 0.0],
    p=[1.0e-06, 0.01, 0.25, 0.5, 0.75, 0.99, 0.999999],
    ppf=[7, 7, 12, 18, 24, 30, 30],
  )
}

