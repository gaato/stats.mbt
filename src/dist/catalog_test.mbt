  ignore(@dist.YuleSimon::new(10.274059520419378))
  ignore(@dist.YuleSimon::new(3.160494824438471))
  ignore(@dist.YuleSimon::new(5.9956440116793726))
  ignore(@dist.YuleSimon::new(5.169654487705664))
