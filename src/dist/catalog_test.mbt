///|
test "catalog: planck matches the high-precision oracle" {
  let d = @dist.Planck::new(0.51)
  check_discrete(
    d,
    k=[0, 1, 2, 9, 27],
    pmf=[0.39950442118773405, 0.23990063863918765, 0.14405927285707124, 0.004056111807854126, 4.181061676684149e-07],
    cdf=[0.39950442118773405, 0.6394050598269218, 0.783464332683993, 0.9939032534344844, 0.9999993715441136],
    sf=[0.6004955788122659, 0.3605949401730783, 0.21653566731600707, 0.006096746565515635, 6.284558864519814e-07],
    p=[1.0e-06, 0.01, 0.25, 0.5, 0.75, 0.99, 0.999999],
    ppf=[0, 0, 0, 1, 2, 9, 27],
  )
}

///|
test "catalog: randint parameters agree with SciPy" {
  ignore(@dist.DiscreteUniform::new(-16, 17))
  ignore(@dist.DiscreteUniform::new(-18, -1))
  ignore(@dist.DiscreteUniform::new(-14, 12))
  ignore(@dist.DiscreteUniform::new(15, 19))
  ignore(@dist.DiscreteUniform::new(5, 10))
  ignore(@dist.DiscreteUniform::new(-14, -7))
  assert_true(
    (try @dist.DiscreteUniform::new(12, -15) catch { _ => true } noraise { _ => false }),
  )
  assert_true(
    (try @dist.DiscreteUniform::new(15, -19) catch { _ => true } noraise { _ => false }),
  )
  assert_true(
    (try @dist.DiscreteUniform::new(19, -6) catch { _ => true } noraise { _ => false }),
  )
  assert_true(
    (try @dist.DiscreteUniform::new(-4, -10) catch { _ => true } noraise { _ => false }),
  )
  assert_true(
    (try @dist.DiscreteUniform::new(1, -9) catch { _ => true } noraise { _ => false }),
  )
  assert_true(
    (try @dist.DiscreteUniform::new(14, 12) catch { _ => true } noraise { _ => false }),
  )
}

///|
test "catalog: randint matches the high-precision oracle" {
  let d = @dist.DiscreteUniform::new(7, 31)
  check_discrete(
    d,
    k=[7, 12, 18, 24, 30],
    pmf=[0.041666666666666664, 0.041666666666666664, 0.041666666666666664, 0.041666666666666664, 0.041666666666666664],
    cdf=[0.041666666666666664, 0.25, 0.5, 0.75, 1.0],
    sf=[0.9583333333333334, 0.75, 0.5, 0.25, 0.0],
    p=[1.0e-06, 0.01, 0.25, 0.5, 0.75, 0.99, 0.999999],
    ppf=[7, 7, 12, 18, 24, 30, 30],
  )
}

