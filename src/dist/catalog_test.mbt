///|
test "catalog: zipfian matches the high-precision oracle" {
  let d = @dist.Zipfian::new(0.75, 15)
  check_discrete(
    d,
    k=[1, 2, 4, 8, 15],
    pmf=[0.2224334606296376, 0.13225972699772132, 0.07864210418700383, 0.046760874918985125, 0.0291831168708635],
    cdf=[0.2224334606296376, 0.3546931876273589, 0.5309149241962818, 0.7539065527485141, 1.0],
    sf=[0.7775665393703625, 0.6453068123726411, 0.4690850758037181, 0.24609344725148588, 0.0],
    p=[1.0e-06, 0.01, 0.25, 0.5, 0.75, 0.99, 0.999999],
    ppf=[1, 1, 2, 4, 8, 15, 15],
  )
}

