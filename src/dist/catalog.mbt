/// `scipy.stats.skewnorm`, with SciPy's shape parameters, location `loc`
/// and scale `scale`: the standard form at (x - loc) / scale.
#derive(Eq, Debug)
pub struct SkewNormal {
  a : Double
  loc : Double
  scale : Double
}

///|
pub fn SkewNormal::new(
  a : Double,
  loc~ : Double = 0.0,
  scale~ : Double = 1.0,
) -> SkewNormal raise ParamError {
  if !(!a.is_nan()) {
    raise InvalidParam(name="a", value=a, reason="must be in not NaN")
  }
  if !(!loc.is_nan() && !loc.is_inf()) {
    raise InvalidParam(name="loc", value=loc, reason="must be finite")
  }
  if !(scale > 0.0 && !scale.is_inf()) {
    raise InvalidParam(name="scale", value=scale, reason="must be in (0, inf)")
  }
  { a, loc, scale, }
}

///|
pub fn SkewNormal::family() -> Family[SkewNormal] {
  {
    name: "skewnorm",
    specs: [
      { name: "a", constraint: Real, },
      { name: "loc", constraint: Real, },
      { name: "scale", constraint: Positive, },
    ],
    make: p => SkewNormal::new(p[0], loc=p[1], scale=p[2]),
    params: d => [d.a, d.loc, d.scale],
  }
}

///|
fn SkewNormal::std_pdf(self : SkewNormal, x : Double) -> Double {
  ignore((self, x))
  ...
}

///|
fn SkewNormal::std_cdf(self : SkewNormal, x : Double) -> Double {
  ignore((self, x))
  ...
}

///|
fn SkewNormal::std_sf(self : SkewNormal, x : Double) -> Double {
  ignore((self, x))
  ...
}

///|
fn SkewNormal::std_quantile(self : SkewNormal, p : Double) -> Double {
  ignore((self, p))
  ...
}

///|
fn SkewNormal::std_isf(self : SkewNormal, q : Double) -> Double {
  ignore((self, q))
  ...
}

///|
fn SkewNormal::std_support(_self : SkewNormal) -> (Double, Double) {
  (-1.0 / 0.0, 1.0 / 0.0)
}

///|
pub impl Density for SkewNormal with fn pdf(self, x) {
  self.std_pdf((x - self.loc) / self.scale) / self.scale
}

///|
pub impl Density for SkewNormal with fn logpdf(self, x) {
  @math.ln(self.std_pdf((x - self.loc) / self.scale)) - @math.ln(self.scale)
}

///|
pub impl Cdf for SkewNormal with fn cdf(self, x) {
  self.std_cdf((x - self.loc) / self.scale)
}

///|
pub impl Cdf for SkewNormal with fn sf(self, x) {
  self.std_sf((x - self.loc) / self.scale)
}

///|
pub impl Quantile for SkewNormal with fn quantile(self, p) {
  self.loc + self.scale * self.std_quantile(p)
}

///|
pub impl Quantile for SkewNormal with fn isf(self, q) {
  self.loc + self.scale * self.std_isf(q)
}

///|
/// Inversion of the quantile function.
