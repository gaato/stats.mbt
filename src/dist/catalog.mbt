///|
/// `scipy.stats.gompertz`, with SciPy's shape parameters, location `loc`
/// and scale `scale`: the standard form at (x - loc) / scale.
#derive(Eq, Debug)
pub struct Gompertz {
  c : Double
  loc : Double
  scale : Double
}

///|
pub fn Gompertz::new(
  c : Double,
  loc~ : Double = 0.0,
  scale~ : Double = 1.0,
) -> Gompertz raise ParamError {
  if !(c > 5.0e-324) {
    raise InvalidParam(name="c", value=c, reason="must be in (5e-324, inf)")
  }
  if !(!loc.is_nan() && !loc.is_inf()) {
    raise InvalidParam(name="loc", value=loc, reason="must be finite")
  }
  if !(scale > 0.0 && !scale.is_inf()) {
    raise InvalidParam(name="scale", value=scale, reason="must be in (0, inf)")
  }
  { c, loc, scale, }
}

///|
pub fn Gompertz::family() -> Family[Gompertz] {
  {
    name: "gompertz",
    specs: [
      { name: "c", constraint: Positive, },
      { name: "loc", constraint: Real, },
      { name: "scale", constraint: Positive, },
    ],
    make: p => Gompertz::new(p[0], loc=p[1], scale=p[2]),
    params: d => [d.c, d.loc, d.scale],
  }
}

