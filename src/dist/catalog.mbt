///|
/// `scipy.stats.wald`, with SciPy's shape parameters, location `loc`
/// and scale `scale`: the standard form at (x - loc) / scale.
#derive(Eq, Debug)
pub struct Wald {
  loc : Double
  scale : Double
}

///|
pub fn Wald::new(
  loc~ : Double = 0.0,
  scale~ : Double = 1.0,
) -> Wald raise ParamError {
  if !(!loc.is_nan() && !loc.is_inf()) {
    raise InvalidParam(name="loc", value=loc, reason="must be finite")
  }
  if !(scale > 0.0 && !scale.is_inf()) {
    raise InvalidParam(name="scale", value=scale, reason="must be in (0, inf)")
  }
  { loc, scale, }
}

///|
pub fn Wald::family() -> Family[Wald] {
  {
    name: "wald",
    specs: [
      { name: "loc", constraint: Real, },
      { name: "scale", constraint: Positive, },
    ],
    make: p => Wald::new(loc=p[0], scale=p[1]),
    params: d => [d.loc, d.scale],
  }
}

///|
fn Wald::std_pdf(self : Wald, x : Double) -> Double {
  ignore((self, x))
  ...
}

///|
fn Wald::std_cdf(self : Wald, x : Double) -> Double {
  ignore((self, x))
  ...
}

///|
fn Wald::std_sf(self : Wald, x : Double) -> Double {
  ignore((self, x))
  ...
}

///|
fn Wald::std_quantile(self : Wald, p : Double) -> Double {
  ignore((self, p))
  ...
}

///|
fn Wald::std_isf(self : Wald, q : Double) -> Double {
  ignore((self, q))
  ...
}

///|
fn Wald::std_support(_self : Wald) -> (Double, Double) {
  (0.0, 1.0 / 0.0)
}

///|
pub impl Density for Wald with fn pdf(self, x) {
  self.std_pdf((x - self.loc) / self.scale) / self.scale
}

///|
pub impl Density for Wald with fn logpdf(self, x) {
  @math.ln(self.std_pdf((x - self.loc) / self.scale)) - @math.ln(self.scale)
}

///|
pub impl Cdf for Wald with fn cdf(self, x) {
  self.std_cdf((x - self.loc) / self.scale)
}

///|
pub impl Cdf for Wald with fn sf(self, x) {
  self.std_sf((x - self.loc) / self.scale)
}

///|
pub impl Quantile for Wald with fn quantile(self, p) {
  self.loc + self.scale * self.std_quantile(p)
}

///|
pub impl Quantile for Wald with fn isf(self, q) {
  self.loc + self.scale * self.std_isf(q)
}

///|
/// Inversion of the quantile function.
pub impl Sample for Wald with fn sample(self, rng) {
  Quantile::quantile(self, @num.uniform_open(rng))
}

///|
pub impl Support for Wald with fn support_lower(self) {
  self.loc + self.scale * self.std_support().0
}

///|
pub impl Support for Wald with fn support_upper(self) {
  self.loc + self.scale * self.std_support().1
}

///|
pub impl Univariate for Wald

///|
pub extend Wald with Cdf::{cdf, sf, logcdf, logsf, sf_at_least}

///|
pub extend Wald with Density::{pdf, logpdf}

///|
pub extend Wald with Quantile::{quantile, isf}

///|
pub extend Wald with Sample::{sample, sample_into}

///|
pub extend Wald with Support::{support_lower, support_upper}

///|
/// `scipy.stats.weibull_max`, with SciPy's shape parameters, location `loc`
/// and scale `scale`: the standard form at (x - loc) / scale.
#derive(Eq, Debug)
pub struct WeibullMax {
  c : Double
  loc : Double
  scale : Double
}

///|
pub fn WeibullMax::new(
  c : Double,
  loc~ : Double = 0.0,
  scale~ : Double = 1.0,
) -> WeibullMax raise ParamError {
  if !(c > 5.0e-324) {
    raise InvalidParam(name="c", value=c, reason="must be in (5e-324, inf)")
  }
  if !(!loc.is_nan() && !loc.is_inf()) {
    raise InvalidParam(name="loc", value=loc, reason="must be finite")
  }
  if !(scale > 0.0 && !scale.is_inf()) {
    raise InvalidParam(name="scale", value=scale, reason="must be in (0, inf)")
  }
  { c, loc, scale, }
}

///|
pub fn WeibullMax::family() -> Family[WeibullMax] {
  {
    name: "weibull_max",
    specs: [
      { name: "c", constraint: Positive, },
      { name: "loc", constraint: Real, },
      { name: "scale", constraint: Positive, },
    ],
    make: p => WeibullMax::new(p[0], loc=p[1], scale=p[2]),
    params: d => [d.c, d.loc, d.scale],
  }
}

///|
fn WeibullMax::std_support(_self : WeibullMax) -> (Double, Double) {
  (-1.0 / 0.0, 0.0)
}

///|
pub impl Density for WeibullMax with fn pdf(self, x) {
  self.std_pdf((x - self.loc) / self.scale) / self.scale
}

///|
pub impl Density for WeibullMax with fn logpdf(self, x) {
  self.std_logpdf((x - self.loc) / self.scale) - @math.ln(self.scale)
}

///|
