///|
/// `scipy.stats.johnsonsu`, with SciPy's shape parameters, location `loc`
/// and scale `scale`: the standard form at (x - loc) / scale.
#derive(Eq, Debug)
pub struct JohnsonSU {
  a : Double
  b : Double
  loc : Double
  scale : Double
}

///|
pub fn JohnsonSU::new(
  a~ : Double,
  b~ : Double,
  loc~ : Double = 0.0,
  scale~ : Double = 1.0,
) -> JohnsonSU raise ParamError {
  if !(!a.is_nan()) {
    raise InvalidParam(name="a", value=a, reason="must be in not NaN")
  }
  if !(b > 5.0e-324) {
    raise InvalidParam(name="b", value=b, reason="must be in (5e-324, inf)")
  }
  if !(!loc.is_nan() && !loc.is_inf()) {
    raise InvalidParam(name="loc", value=loc, reason="must be finite")
  }
  if !(scale > 0.0 && !scale.is_inf()) {
    raise InvalidParam(name="scale", value=scale, reason="must be in (0, inf)")
  }
  { a, b, loc, scale, }
}

///|
pub fn JohnsonSU::family() -> Family[JohnsonSU] {
  {
    name: "johnsonsu",
    specs: [
      { name: "a", constraint: Real, },
      { name: "b", constraint: Positive, },
      { name: "loc", constraint: Real, },
      { name: "scale", constraint: Positive, },
    ],
    make: p => JohnsonSU::new(a=p[0], b=p[1], loc=p[2], scale=p[3]),
    params: d => [d.a, d.b, d.loc, d.scale],
  }
}

///|
fn JohnsonSU::std_pdf(self : JohnsonSU, x : Double) -> Double {
  ignore((self, x))
  ...
}

///|
fn JohnsonSU::std_cdf(self : JohnsonSU, x : Double) -> Double {
  ignore((self, x))
  ...
}

///|
fn JohnsonSU::std_sf(self : JohnsonSU, x : Double) -> Double {
  ignore((self, x))
  ...
}

///|
fn JohnsonSU::std_quantile(self : JohnsonSU, p : Double) -> Double {
  ignore((self, p))
  ...
}

///|
fn JohnsonSU::std_isf(self : JohnsonSU, q : Double) -> Double {
  ignore((self, q))
  ...
}

///|
fn JohnsonSU::std_support(_self : JohnsonSU) -> (Double, Double) {
  (-1.0 / 0.0, 1.0 / 0.0)
}

///|
pub impl Density for JohnsonSU with fn pdf(self, x) {
  self.std_pdf((x - self.loc) / self.scale) / self.scale
}

///|
pub impl Density for JohnsonSU with fn logpdf(self, x) {
  @math.ln(self.std_pdf((x - self.loc) / self.scale)) - @math.ln(self.scale)
}

///|
pub impl Cdf for JohnsonSU with fn cdf(self, x) {
  self.std_cdf((x - self.loc) / self.scale)
}

///|
pub impl Cdf for JohnsonSU with fn sf(self, x) {
  self.std_sf((x - self.loc) / self.scale)
}

///|
pub impl Quantile for JohnsonSU with fn quantile(self, p) {
  self.loc + self.scale * self.std_quantile(p)
}

///|
pub impl Quantile for JohnsonSU with fn isf(self, q) {
  self.loc + self.scale * self.std_isf(q)
}

///|
/// Inversion of the quantile function.
pub impl Sample for JohnsonSU with fn sample(self, rng) {
  Quantile::quantile(self, @num.uniform_open(rng))
}

///|
pub impl Support for JohnsonSU with fn support_lower(self) {
  self.loc + self.scale * self.std_support().0
}

///|
pub impl Support for JohnsonSU with fn support_upper(self) {
  self.loc + self.scale * self.std_support().1
}

///|
pub impl Univariate for JohnsonSU

