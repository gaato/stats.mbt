      { name: "s", constraint: Positive, },
      { name: "a", constraint: Positive, },
      { name: "b", constraint: Positive, },
      { name: "loc", constraint: Real, },
      { name: "scale", constraint: Positive, },
    ],
    make: p => {
      DoubleParetoLognormal::new(
        u=p[0],
        s=p[1],
        a=p[2],
        b=p[3],
        loc=p[4],
        scale=p[5],
      )
    },
    params: d => [d.u, d.s, d.a, d.b, d.loc, d.scale],
  }
}

