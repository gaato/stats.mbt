  {
    name: "gausshyper",
    specs: [{ name: "a", constraint: Positive }, { name: "b", constraint: Positive }, { name: "c", constraint: Real }, { name: "z", constraint: Above(-0.9999999999999999) }],
    make: p => GaussHypergeometric::new(p[0], p[1], p[2], p[3]),
    params: d => [d.a, d.b, d.c, d.z],
  }
}

