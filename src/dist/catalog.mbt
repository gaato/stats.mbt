  a : Double,
  loc~ : Double = 0.0,
  scale~ : Double = 1.0,
) -> SkewCauchy raise ParamError {
  if !(a > -0.9999999999999999 && a < 0.9999999999999999) {
    raise InvalidParam(
      name="a",
      value=a,
      reason="must be in (-0.9999999999999999, 0.9999999999999999)",
    )
