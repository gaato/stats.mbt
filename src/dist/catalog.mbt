pub fn IrwinHall::family(n~ : Int64) -> Family[IrwinHall] {
  {
    name: "irwinhall",
    specs: [
      { name: "loc", constraint: Real, },
      { name: "scale", constraint: Positive, },
    ],
    make: p => IrwinHall::new(n, loc=p[0], scale=p[1]),
    params: d => [d.loc, d.scale],
  }
}

