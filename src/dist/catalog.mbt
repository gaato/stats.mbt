///|
/// `scipy.stats.skellam` (loc 0).
#derive(Eq, Debug)
pub struct Skellam {
  mu1 : Double
  mu2 : Double
}

///|
pub fn Skellam::new(mu1~ : Double, mu2~ : Double) -> Skellam raise ParamError {
  if !(mu1 > 5.0e-324) {
    raise InvalidParam(name="mu1", value=mu1, reason="must be in (5e-324, inf)")
  }
  if !(mu2 > 5.0e-324) {
    raise InvalidParam(name="mu2", value=mu2, reason="must be in (5e-324, inf)")
  }
  { mu1, mu2, }
}

///|
pub fn Skellam::family() -> Family[Skellam] {
  {
    name: "skellam",
    specs: [
      { name: "mu1", constraint: Positive, },
      { name: "mu2", constraint: Positive, },
    ],
    make: p => Skellam::new(mu1=p[0], mu2=p[1]),
    params: d => [d.mu1, d.mu2],
  }
}

