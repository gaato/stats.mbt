pub struct Zipf {
  a : Double
}

///|
pub fn Zipf::new(a : Double) -> Zipf raise ParamError {
  if !(a > 1.0000000000000002) {
    raise InvalidParam(
      name="a",
      value=a,
      reason="must be in (1.0000000000000002, inf)",
    )
  }
  { a, }
}

