///|
/// `scipy.stats.zipfian` (loc 0).
/// Parameters: need n > 0.
#derive(Eq, Debug)
pub struct Zipfian {
  a : Double
  n : Int64
}

///|
pub fn Zipfian::new(a~ : Double, n~ : Int64) -> Zipfian raise ParamError {
  if !(a >= 0.0) {
    raise InvalidParam(name="a", value=a, reason="must be in [0.0, inf)")
  }
  if !(n >= 1) {
    raise InvalidParam(
      name="n",
      value=n.to_double(),
      reason="must be in (5e-324, inf)",
    )
  }
  if !(n > 0) {
    raise InvalidParam(name="n", value=n.to_double(), reason="need n > 0")
  }
  { a, n, }
}

///|
pub fn Zipfian::family(n~ : Int64) -> Family[Zipfian] {
  {
    name: "zipfian",
    specs: [{ name: "a", constraint: Positive, }],
    make: p => Zipfian::new(a=p[0], n~),
    params: d => [d.a],
  }
}

