///|
/// `scipy.stats.t`, with SciPy's shape parameters, location `loc`
/// and scale `scale`: the standard form at (x - loc) / scale.
#derive(Eq, Debug)
pub struct StudentT {
  df : Double
  loc : Double
  scale : Double
}

///|
pub fn StudentT::new(
  df : Double,
  loc~ : Double = 0.0,
  scale~ : Double = 1.0,
) -> StudentT raise ParamError {
  if !(df > 5.0e-324) {
    raise InvalidParam(name="df", value=df, reason="must be in (5e-324, inf)")
  }
  if !(!loc.is_nan() && !loc.is_inf()) {
    raise InvalidParam(name="loc", value=loc, reason="must be finite")
  }
  if !(scale > 0.0 && !scale.is_inf()) {
    raise InvalidParam(name="scale", value=scale, reason="must be in (0, inf)")
  }
  { df, loc, scale, }
}

///|
pub fn StudentT::family() -> Family[StudentT] {
  {
    name: "t",
    specs: [
      { name: "df", constraint: Positive, },
      { name: "loc", constraint: Real, },
      { name: "scale", constraint: Positive, },
    ],
    make: p => StudentT::new(p[0], loc=p[1], scale=p[2]),
    params: d => [d.df, d.loc, d.scale],
  }
}

///|
fn StudentT::std_support(_self : StudentT) -> (Double, Double) {
  (-1.0 / 0.0, 1.0 / 0.0)
}

///|
pub impl Density for StudentT with fn pdf(self, x) {
  self.std_pdf((x - self.loc) / self.scale) / self.scale
}

///|
pub impl Density for StudentT with fn logpdf(self, x) {
  self.std_logpdf((x - self.loc) / self.scale) - @math.ln(self.scale)
}

///|
pub impl Cdf for StudentT with fn cdf(self, x) {
  self.std_cdf((x - self.loc) / self.scale)
}

///|
pub impl Cdf for StudentT with fn sf(self, x) {
  self.std_sf((x - self.loc) / self.scale)
}

///|
pub impl Quantile for StudentT with fn quantile(self, p) {
  self.loc + self.scale * self.std_quantile(p)
}

///|
pub impl Quantile for StudentT with fn isf(self, q) {
  self.loc + self.scale * self.std_isf(q)
}

///|
/// Inversion of the quantile function.
pub impl Sample for StudentT with fn sample(self, rng) {
  Quantile::quantile(self, @num.uniform_open(rng))
}

///|
pub impl Moments for StudentT with fn mean(self) {
  match self.std_mean() {
    Some(m) => Some(self.loc + self.scale * m)
    None => None
  }
}

///|
pub impl Moments for StudentT with fn variance(self) {
  match self.std_variance() {
    Some(v) => Some(self.scale * self.scale * v)
    None => None
  }
}

///|
pub impl Characteristic for StudentT with fn cf(self, t) {
  let (re, im) = self.std_cf(self.scale * t)
  let c = @math.cos(self.loc * t)
  let s = @math.sin(self.loc * t)
  (re * c - im * s, re * s + im * c)
}

///|
pub impl Support for StudentT with fn support_lower(self) {
  self.loc + self.scale * self.std_support().0
}

///|
pub impl Support for StudentT with fn support_upper(self) {
  self.loc + self.scale * self.std_support().1
}

///|
pub impl Univariate for StudentT

