///|
/// `scipy.stats.nbinom` (loc 0).
/// Parameters: need n > 0 and p > 0.
#derive(Eq, Debug)
pub struct NegativeBinomial {
  n : Int64
  p : Double
}

///|
pub fn NegativeBinomial::new(
  n~ : Int64,
  p~ : Double,
) -> NegativeBinomial raise ParamError {
  if !(n >= 0) {
    raise InvalidParam(
      name="n",
      value=n.to_double(),
      reason="must be in [0.0, inf)",
    )
  }
  if !(p >= 0.0 && p <= 1.0) {
    raise InvalidParam(name="p", value=p, reason="must be in [0.0, 1.0]")
  }
  if !(n > 0 && p > 0.0) {
    raise InvalidParam(
      name="n",
      value=n.to_double(),
      reason="need n > 0 and p > 0",
    )
  }
  { n, p, }
}

///|
pub fn NegativeBinomial::family(n~ : Int64) -> Family[NegativeBinomial] {
  {
    name: "nbinom",
    specs: [{ name: "p", constraint: UnitInterval, }],
    make: p => NegativeBinomial::new(n~, p=p[0]),
    params: d => [d.p],
  }
}

