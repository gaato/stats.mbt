}

///|
pub fn AsymmetricLaplace::new(
  kappa : Double,
  loc~ : Double = 0.0,
  scale~ : Double = 1.0,
) -> AsymmetricLaplace raise ParamError {
  if !(kappa > 5.0e-324) {
