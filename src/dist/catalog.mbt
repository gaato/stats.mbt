///|
/// `scipy.stats.bernoulli` (loc 0).
#derive(Eq, Debug)
pub struct Bernoulli {
  p : Double
}

///|
pub fn Bernoulli::new(p : Double) -> Bernoulli raise ParamError {
  if !(p >= 0.0 && p <= 1.0) {
    raise InvalidParam(name="p", value=p, reason="must be in [0.0, 1.0]")
  }
  { p, }
}

///|
pub fn Bernoulli::family() -> Family[Bernoulli] {
  {
    name: "bernoulli",
    specs: [{ name: "p", constraint: UnitInterval, }],
    make: p => Bernoulli::new(p[0]),
    params: d => [d.p],
  }
}

///|
pub impl Mass for Bernoulli with fn pmf(self, k) {
  self.lattice_pmf(k.to_double())
}

///|
pub impl IntCdf for Bernoulli with fn cdf_int(self, k) {
  self.lattice_cdf(k.to_double())
}

///|
pub impl IntCdf for Bernoulli with fn sf_int(self, k) {
  self.lattice_sf(k.to_double())
}

///|
pub impl IntQuantile for Bernoulli with fn quantile_int(self, p) {
  saturate_int64(self.lattice_quantile(p))
}

///|
pub impl SampleInt for Bernoulli with fn sample_int(self, rng) {
  saturate_int64(self.lattice_quantile(@num.uniform_open(rng)))
}

///|
pub impl Cdf for Bernoulli with fn cdf(self, x) {
  self.lattice_cdf(@math.floor(x))
}

///|
pub impl Cdf for Bernoulli with fn sf(self, x) {
  self.lattice_sf(@math.floor(x))
}

///|
pub impl Cdf for Bernoulli with fn sf_at_least(self, x) {
  self.lattice_sf(@math.ceil(x) - 1.0)
}

///|
pub impl Quantile for Bernoulli with fn quantile(self, p) {
  self.lattice_quantile(p)
}

///|
pub impl Quantile for Bernoulli with fn isf(self, q) {
  let (lo, hi) = self.lattice_support()
  lattice_isf(k => self.lattice_sf(k), q, lo, hi)
}

///|
pub impl Sample for Bernoulli with fn sample(self, rng) {
  self.lattice_quantile(@num.uniform_open(rng))
}

///|
pub impl Support for Bernoulli with fn support_lower(self) {
  self.lattice_support().0
}

///|
pub impl Support for Bernoulli with fn support_upper(self) {
  self.lattice_support().1
}

///|
pub impl Univariate for Bernoulli

///|
pub extend Bernoulli with Cdf::{cdf, sf, logcdf, logsf, sf_at_least}

///|
pub extend Bernoulli with IntCdf::{cdf_int, sf_int}

///|
pub extend Bernoulli with IntQuantile::{quantile_int}

///|
pub extend Bernoulli with Mass::{pmf, logpmf}

///|
pub extend Bernoulli with Quantile::{quantile, isf}

///|
pub extend Bernoulli with Sample::{sample, sample_into}

///|
pub extend Bernoulli with SampleInt::{sample_int}

///|
pub extend Bernoulli with Support::{support_lower, support_upper}

///|
/// `scipy.stats.betabinom` (loc 0).
#derive(Eq, Debug)
pub struct BetaBinomial {
  n : Int64
  a : Double
  b : Double
}

///|
pub fn BetaBinomial::new(
  n~ : Int64,
  a~ : Double,
  b~ : Double,
) -> BetaBinomial raise ParamError {
  if !(n >= 0) {
    raise InvalidParam(
      name="n",
      value=n.to_double(),
      reason="must be in [0.0, inf)",
    )
  }
  if !(a > 5.0e-324) {
    raise InvalidParam(name="a", value=a, reason="must be in (5e-324, inf)")
  }
  if !(b > 5.0e-324) {
    raise InvalidParam(name="b", value=b, reason="must be in (5e-324, inf)")
  }
  { n, a, b, }
}

///|
pub fn BetaBinomial::family(n~ : Int64) -> Family[BetaBinomial] {
  {
    name: "betabinom",
    specs: [
      { name: "a", constraint: Positive, },
      { name: "b", constraint: Positive, },
    ],
    make: p => BetaBinomial::new(n~, a=p[0], b=p[1]),
    params: d => [d.a, d.b],
  }
}

///|
fn BetaBinomial::lattice_pmf(self : BetaBinomial, k : Double) -> Double {
  ignore((self, k))
  ...
}

