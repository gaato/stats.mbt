///|
/// `scipy.stats.invgamma`, with SciPy's shape parameters, location `loc`
/// and scale `scale`: the standard form at (x - loc) / scale.
#derive(Eq, Debug)
pub struct InverseGamma {
  a : Double
  loc : Double
  scale : Double
}

///|
pub fn InverseGamma::new(
  a : Double,
  loc~ : Double = 0.0,
  scale~ : Double = 1.0,
) -> InverseGamma raise ParamError {
  if !(a > 5.0e-324) {
    raise InvalidParam(name="a", value=a, reason="must be in (5e-324, inf)")
  }
  if !(!loc.is_nan() && !loc.is_inf()) {
    raise InvalidParam(name="loc", value=loc, reason="must be finite")
  }
  if !(scale > 0.0 && !scale.is_inf()) {
    raise InvalidParam(name="scale", value=scale, reason="must be in (0, inf)")
  }
  { a, loc, scale, }
}

///|
pub fn InverseGamma::family() -> Family[InverseGamma] {
  {
    name: "invgamma",
    specs: [
      { name: "a", constraint: Positive, },
      { name: "loc", constraint: Real, },
      { name: "scale", constraint: Positive, },
    ],
    make: p => InverseGamma::new(p[0], loc=p[1], scale=p[2]),
    params: d => [d.a, d.loc, d.scale],
  }
}

///|
fn InverseGamma::std_pdf(self : InverseGamma, x : Double) -> Double {
  ignore((self, x))
  ...
}

///|
fn InverseGamma::std_cdf(self : InverseGamma, x : Double) -> Double {
  ignore((self, x))
  ...
}

///|
fn InverseGamma::std_sf(self : InverseGamma, x : Double) -> Double {
  ignore((self, x))
  ...
}

///|
fn InverseGamma::std_quantile(self : InverseGamma, p : Double) -> Double {
  ignore((self, p))
  ...
}

///|
fn InverseGamma::std_isf(self : InverseGamma, q : Double) -> Double {
  ignore((self, q))
  ...
}

///|
fn InverseGamma::std_support(_self : InverseGamma) -> (Double, Double) {
  (0.0, 1.0 / 0.0)
}

///|
pub impl Density for InverseGamma with fn pdf(self, x) {
  self.std_pdf((x - self.loc) / self.scale) / self.scale
}

///|
pub impl Density for InverseGamma with fn logpdf(self, x) {
  @math.ln(self.std_pdf((x - self.loc) / self.scale)) - @math.ln(self.scale)
}

///|
pub impl Cdf for InverseGamma with fn cdf(self, x) {
  self.std_cdf((x - self.loc) / self.scale)
}

///|
pub impl Cdf for InverseGamma with fn sf(self, x) {
  self.std_sf((x - self.loc) / self.scale)
}

///|
pub impl Quantile for InverseGamma with fn quantile(self, p) {
  self.loc + self.scale * self.std_quantile(p)
}

///|
pub impl Quantile for InverseGamma with fn isf(self, q) {
  self.loc + self.scale * self.std_isf(q)
}

