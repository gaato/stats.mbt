/// `scipy.stats.boltzmann` in standard form (loc 0).
/// Parameters: need n > 0.
pub struct Boltzmann {
  priv lambda : Double
  priv n : Int32
}

///|
pub fn Boltzmann::new(lambda : Double, n : Int32) -> Boltzmann raise ParamError {
  if !(lambda > 5.0e-324) {
    raise InvalidParam(
      name="lambda",
      value=lambda,
      reason="must be in (5e-324, inf)",
    )
  }
  if !(n >= 1) {
    raise InvalidParam(
      name="n",
      value=n.to_double(),
      reason="must be in (5e-324, inf)",
