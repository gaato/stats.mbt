/// `scipy.stats.norm`, with SciPy's shape parameters, location `loc`
/// and scale `scale`: the standard form at (x - loc) / scale.
#derive(Eq, Debug)
pub struct Normal {
  loc : Double
  scale : Double
}

///|
pub fn Normal::new(
  loc~ : Double = 0.0,
  scale~ : Double = 1.0,
) -> Normal raise ParamError {
  if !(!loc.is_nan() && !loc.is_inf()) {
    raise InvalidParam(name="loc", value=loc, reason="must be finite")
  }
  if !(scale > 0.0 && !scale.is_inf()) {
    raise InvalidParam(name="scale", value=scale, reason="must be in (0, inf)")
  }
  { loc, scale, }
}

///|
pub fn Normal::family() -> Family[Normal] {
  {
    name: "norm",
    specs: [
      { name: "loc", constraint: Real, },
      { name: "scale", constraint: Positive, },
    ],
    make: p => Normal::new(loc=p[0], scale=p[1]),
    params: d => [d.loc, d.scale],
  }
}

///|
fn Normal::std_support(_self : Normal) -> (Double, Double) {
  (-1.0 / 0.0, 1.0 / 0.0)
}

///|
pub impl Density for Normal with fn pdf(self, x) {
  self.std_pdf((x - self.loc) / self.scale) / self.scale
}

///|
pub impl Density for Normal with fn logpdf(self, x) {
  self.std_logpdf((x - self.loc) / self.scale) - @math.ln(self.scale)
}

///|
pub impl Cdf for Normal with fn cdf(self, x) {
  self.std_cdf((x - self.loc) / self.scale)
}

///|
pub impl Cdf for Normal with fn sf(self, x) {
  self.std_sf((x - self.loc) / self.scale)
}

///|
pub impl Cdf for Normal with fn logcdf(self, x) {
  self.std_logcdf((x - self.loc) / self.scale)
}

///|
pub impl Cdf for Normal with fn logsf(self, x) {
  self.std_logsf((x - self.loc) / self.scale)
}

///|
pub impl Quantile for Normal with fn quantile(self, p) {
  self.loc + self.scale * self.std_quantile(p)
}

///|
pub impl Quantile for Normal with fn isf(self, q) {
  self.loc + self.scale * self.std_isf(q)
}

///|
/// Inversion of the quantile function.
pub impl Sample for Normal with fn sample(self, rng) {
  Quantile::quantile(self, @num.uniform_open(rng))
}

///|
pub impl Moments for Normal with fn mean(self) {
  match self.std_mean() {
    Some(m) => Some(self.loc + self.scale * m)
    None => None
  }
}

///|
pub impl Moments for Normal with fn variance(self) {
  match self.std_variance() {
    Some(v) => Some(self.scale * self.scale * v)
    None => None
  }
}

///|
pub impl Mgf for Normal with fn mgf(self, t) {
  match self.std_mgf(self.scale * t) {
    Some(m) => Some(@math.exp(self.loc * t) * m)
    None => None
  }
}

///|
pub impl Characteristic for Normal with fn cf(self, t) {
  let (re, im) = self.std_cf(self.scale * t)
  let c = @math.cos(self.loc * t)
  let s = @math.sin(self.loc * t)
  (re * c - im * s, re * s + im * c)
}

///|
pub impl Support for Normal with fn support_lower(self) {
  self.loc + self.scale * self.std_support().0
}

///|
pub impl Support for Normal with fn support_upper(self) {
  self.loc + self.scale * self.std_support().1
}

///|
pub impl Mode for Normal with fn mode(self) {
  self.loc + self.scale * self.std_mode()
}

