///|
/// `scipy.stats.wrapcauchy`, with SciPy's shape parameters, location `loc`
/// and scale `scale`: the standard form at (x - loc) / scale.
#derive(Eq, Debug)
pub struct WrappedCauchy {
  c : Double
  loc : Double
  scale : Double
}

///|
pub fn WrappedCauchy::new(
  c : Double,
  loc~ : Double = 0.0,
  scale~ : Double = 1.0,
) -> WrappedCauchy raise ParamError {
  if !(c > 5.0e-324 && c < 0.9999999999999999) {
    raise InvalidParam(
      name="c",
      value=c,
      reason="must be in (5e-324, 0.9999999999999999)",
    )
  }
  if !(!loc.is_nan() && !loc.is_inf()) {
    raise InvalidParam(name="loc", value=loc, reason="must be finite")
  }
  if !(scale > 0.0 && !scale.is_inf()) {
    raise InvalidParam(name="scale", value=scale, reason="must be in (0, inf)")
  }
  { c, loc, scale, }
}

///|
pub fn WrappedCauchy::family() -> Family[WrappedCauchy] {
  {
    name: "wrapcauchy",
    specs: [
      { name: "c", constraint: Interval(lo=0.0, hi=0.9999999999999999), },
      { name: "loc", constraint: Real, },
      { name: "scale", constraint: Positive, },
    ],
    make: p => WrappedCauchy::new(p[0], loc=p[1], scale=p[2]),
    params: d => [d.c, d.loc, d.scale],
  }
}

///|
fn WrappedCauchy::std_pdf(self : WrappedCauchy, x : Double) -> Double {
  ignore((self, x))
  ...
}

///|
fn WrappedCauchy::std_cdf(self : WrappedCauchy, x : Double) -> Double {
  ignore((self, x))
  ...
}

///|
fn WrappedCauchy::std_sf(self : WrappedCauchy, x : Double) -> Double {
  ignore((self, x))
  ...
}

///|
fn WrappedCauchy::std_quantile(self : WrappedCauchy, p : Double) -> Double {
  ignore((self, p))
  ...
}

///|
fn WrappedCauchy::std_isf(self : WrappedCauchy, q : Double) -> Double {
  ignore((self, q))
  ...
}

///|
fn WrappedCauchy::std_support(_self : WrappedCauchy) -> (Double, Double) {
  (0.0, 6.283185307179586)
}

///|
pub impl Density for WrappedCauchy with fn pdf(self, x) {
  self.std_pdf((x - self.loc) / self.scale) / self.scale
}

///|
pub impl Density for WrappedCauchy with fn logpdf(self, x) {
  @math.ln(self.std_pdf((x - self.loc) / self.scale)) - @math.ln(self.scale)
}

///|
pub impl Cdf for WrappedCauchy with fn cdf(self, x) {
  self.std_cdf((x - self.loc) / self.scale)
}

///|
pub impl Cdf for WrappedCauchy with fn sf(self, x) {
  self.std_sf((x - self.loc) / self.scale)
}

///|
pub impl Quantile for WrappedCauchy with fn quantile(self, p) {
  self.loc + self.scale * self.std_quantile(p)
}

///|
pub impl Quantile for WrappedCauchy with fn isf(self, q) {
  self.loc + self.scale * self.std_isf(q)
}

///|
/// Inversion of the quantile function.
pub impl Sample for WrappedCauchy with fn sample(self, rng) {
  Quantile::quantile(self, @num.uniform_open(rng))
}

///|
pub impl Support for WrappedCauchy with fn support_lower(self) {
  self.loc + self.scale * self.std_support().0
}

///|
