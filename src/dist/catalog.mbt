///|
/// `scipy.stats.boltzmann` (loc 0).
/// Parameters: need n > 0.
#derive(Eq, Debug)
pub struct Boltzmann {
  lambda : Double
  n : Int64
}

///|
pub fn Boltzmann::new(
  lambda~ : Double,
  n~ : Int64,
) -> Boltzmann raise ParamError {
  if !(lambda > 5.0e-324) {
    raise InvalidParam(
      name="lambda",
      value=lambda,
      reason="must be in (5e-324, inf)",
    )
  }
  if !(n >= 1) {
    raise InvalidParam(
      name="n",
      value=n.to_double(),
      reason="must be in (5e-324, inf)",
    )
  }
  if !(n > 0) {
    raise InvalidParam(name="n", value=n.to_double(), reason="need n > 0")
  }
  { lambda, n, }
}

///|
pub fn Boltzmann::family(n~ : Int64) -> Family[Boltzmann] {
  {
    name: "boltzmann",
    specs: [{ name: "lambda", constraint: Positive, }],
    make: p => Boltzmann::new(lambda=p[0], n~),
    params: d => [d.lambda],
  }
}

