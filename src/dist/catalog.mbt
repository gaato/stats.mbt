///|
/// `scipy.stats.hypergeom` (loc 0).
/// Parameters: need successes, draws <= population.
/// `population` items of which `successes` are marked; `draws` are taken
/// without replacement, and the variable counts the marked ones drawn.
#derive(Eq, Debug)
pub struct Hypergeometric {
  population : Int64
  successes : Int64
  draws : Int64
}

///|
pub fn Hypergeometric::new(
  population~ : Int64,
  successes~ : Int64,
  draws~ : Int64,
) -> Hypergeometric raise ParamError {
  if !(population >= 0) {
    raise InvalidParam(
      name="population",
      value=population.to_double(),
      reason="must be in [0.0, inf)",
    )
  }
  if !(successes >= 0) {
    raise InvalidParam(
      name="successes",
      value=successes.to_double(),
      reason="must be in [0.0, inf)",
    )
  }
  if !(draws >= 0) {
    raise InvalidParam(
      name="draws",
      value=draws.to_double(),
      reason="must be in [0.0, inf)",
    )
  }
  if !(successes <= population && draws <= population) {
    raise InvalidParam(
      name="successes",
      value=successes.to_double(),
      reason="need successes, draws <= population",
    )
  }
  { population, successes, draws, }
}

///|
pub fn Hypergeometric::family(
  population~ : Int64,
  successes~ : Int64,
  draws~ : Int64,
) -> Family[Hypergeometric] {
  {
    name: "hypergeom",
    specs: [],
    make: _ => Hypergeometric::new(population~, successes~, draws~),
    params: _ => [],
  }
}

