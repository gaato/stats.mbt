///|
/// `scipy.stats.trapezoid`, with SciPy's shape parameters, location `loc`
/// and scale `scale`: the standard form at (x - loc) / scale.
/// Parameters: need c <= d.
#derive(Eq, Debug)
pub struct Trapezoid {
  c : Double
  d : Double
  loc : Double
  scale : Double
}

///|
pub fn Trapezoid::new(
  c~ : Double,
  d~ : Double,
  loc~ : Double = 0.0,
  scale~ : Double = 1.0,
) -> Trapezoid raise ParamError {
  if !(c >= 0.0 && c <= 1.0) {
    raise InvalidParam(name="c", value=c, reason="must be in [0.0, 1.0]")
  }
  if !(d >= 0.0 && d <= 1.0) {
    raise InvalidParam(name="d", value=d, reason="must be in [0.0, 1.0]")
  }
  if !(!loc.is_nan() && !loc.is_inf()) {
    raise InvalidParam(name="loc", value=loc, reason="must be finite")
  }
  if !(scale > 0.0 && !scale.is_inf()) {
    raise InvalidParam(name="scale", value=scale, reason="must be in (0, inf)")
  }
  if !(c <= d) {
    raise InvalidParam(name="d", value=d, reason="need c <= d")
  }
  { c, d, loc, scale, }
}

///|
pub fn Trapezoid::family() -> Family[Trapezoid] {
  {
    name: "trapezoid",
    specs: [
      { name: "c", constraint: UnitInterval, },
      { name: "d", constraint: UnitInterval, },
      { name: "loc", constraint: Real, },
      { name: "scale", constraint: Positive, },
    ],
    make: p => Trapezoid::new(c=p[0], d=p[1], loc=p[2], scale=p[3]),
    params: d => [d.c, d.d, d.loc, d.scale],
  }
}

