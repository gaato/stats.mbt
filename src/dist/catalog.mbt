///|
/// `scipy.stats.irwinhall`, with SciPy's shape parameters, location `loc`
/// and scale `scale`: the standard form at (x - loc) / scale.
#derive(Eq, Debug)
pub struct IrwinHall {
  n : Int64
  loc : Double
  scale : Double
}

///|
pub fn IrwinHall::new(
  n : Int64,
  loc~ : Double = 0.0,
  scale~ : Double = 1.0,
) -> IrwinHall raise ParamError {
  if !(n >= 1) {
    raise InvalidParam(
      name="n",
      value=n.to_double(),
      reason="must be in [1.0, inf)",
    )
  }
  if !(!loc.is_nan() && !loc.is_inf()) {
    raise InvalidParam(name="loc", value=loc, reason="must be finite")
  }
  if !(scale > 0.0 && !scale.is_inf()) {
    raise InvalidParam(name="scale", value=scale, reason="must be in (0, inf)")
  }
  { n, loc, scale, }
}

